# Copy this file to `.env` and fill in real values.

# MongoDB connection string.
# Local Mongo:   mongodb://127.0.0.1:27017/skillswap
# Atlas (cloud): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/skillswap
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# Long random string used to sign JWTs. Change in production!
JWT_SECRET=dev-secret-change-me

# API port
PORT=4000
